+    needsReview:results.filter(r=>(r.state==='SUPERSEDED'||r.state==='INCONCLUSIVE')&&r.reason!=='LEGACY_NOT_LIVE_PRECOMMITTED').map(r=>r.decisionId),
+    autonomousRuleUpdateAuthorized:false};
+}
