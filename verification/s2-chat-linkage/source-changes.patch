+type Facts={summary:string[];details:string[]}
+const round=(n:number)=>Number(n.toFixed(2))
+const clip=(s:string,n:number)=>s.length<=n?s:s.slice(0,n-8)+'（明细省略）'
+const time=(v:unknown):v is string=>typeof v==='string'&&strictIso(v)
