+  }
+  if(currentAthleteId()!==owner)return fail('运动员档案已切换，旧恢复摘要已丢弃。')
+  return{summary:summary.map(s=>clip(s,500)),details:details.slice(0,8)}
+ }catch{return fail(`${day} 部分恢复来源读取失败，不能解释为没有健康、休息或训练记录。`)}
+}
